# Set private values in the ignored .env.local, never NEXT_PUBLIC_*.
# Supabase: Project → Connect → "Session pooler" URI (port 5432), replacing [YOUR-PASSWORD].
# Append ?uselibpqcompat=true&sslmode=require so node-postgres uses TLS like libpq.
DATABASE_URL=
# Optional direct connection for migrations (Supabase "Direct connection" URI, IPv6 only on free tier).
DATABASE_URL_UNPOOLED=
LOG_LEVEL=info
# Chat photos (private Supabase Storage bucket "chat-images", created by `pnpm storage:setup`).
# Project URL, e.g. https://<ref>.supabase.co
SUPABASE_URL=
# Project Settings → API Keys → secret key (sb_secret_...) or legacy service_role. Server-only.
SUPABASE_SECRET_KEY=
